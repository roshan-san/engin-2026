											"!~/features/work/**",
											"~/features/work",
											"../**/billing",
											"../**/billing/**",
											"../**/chat",
											"../**/chat/**",
											"../**/explore",
											"../**/explore/**",
											"../**/hiring",
											"../**/hiring/**",
											"../**/marketing",
											"../**/marketing/**",
											"../**/people",
											"../**/people/**",
											"../**/startups",
											"../**/startups/**"
										],
										"message": "From another area, import its front door (~/features/<area>). Inside work/, import files directly, not ~/features/work."
									}
								]
