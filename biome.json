											"!@convex/_generated/**",
											"!@convex/shared/**",
											"../**/convex/**",
											"!../**/convex/_generated/**",
											"!../**/convex/shared/**"
										],
										"message": "src/ may import only @convex/_generated/* and @convex/shared/* from the backend."
									},
									{
										"group": [
											"~/features/*/**",
											"!~/features/explore/**",
											"~/features/explore",
											"../**/billing",
											"../**/billing/**",
											"../**/chat",
											"../**/chat/**",
											"../**/hiring",
											"../**/hiring/**",
											"../**/marketing",
											"../**/marketing/**",
											"../**/people",
											"../**/people/**",
											"../**/startups",
											"../**/startups/**",
											"../**/work",
											"../**/work/**"
										],
										"message": "From another area, import its front door (~/features/<area>). Inside explore/, import files directly, not ~/features/explore."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/features/hiring/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@convex/**",
											"!@convex/_generated/**",
											"!@convex/shared/**",
											"../**/convex/**",
											"!../**/convex/_generated/**",
											"!../**/convex/shared/**"
										],
										"message": "src/ may import only @convex/_generated/* and @convex/shared/* from the backend."
									},
									{
										"group": [
											"~/features/*/**",
											"!~/features/hiring/**",
											"~/features/hiring",
											"../**/billing",
											"../**/billing/**",
											"../**/chat",
											"../**/chat/**",
											"../**/explore",
											"../**/explore/**",
											"../**/marketing",
											"../**/marketing/**",
											"../**/people",
											"../**/people/**",
											"../**/startups",
											"../**/startups/**",
											"../**/work",
											"../**/work/**"
										],
										"message": "From another area, import its front door (~/features/<area>). Inside hiring/, import files directly, not ~/features/hiring."
									}
