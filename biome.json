{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**/src/**/*",
			"**/convex/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"**/vitest.config.ts",
			"!**/src/app/routeTree.gen.ts",
			"!**/convex/_generated/**/*"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": [
				"**/src/shared/ui/alert-dialog.tsx",
				"**/src/shared/ui/avatar.tsx",
				"**/src/shared/ui/badge.tsx",
				"**/src/shared/ui/button.tsx",
				"**/src/shared/ui/collapsible.tsx",
				"**/src/shared/ui/command.tsx",
				"**/src/shared/ui/dialog.tsx",
				"**/src/shared/ui/dropdown-menu.tsx",
				"**/src/shared/ui/input.tsx",
				"**/src/shared/ui/label.tsx",
				"**/src/shared/ui/popover.tsx",
				"**/src/shared/ui/select.tsx",
				"**/src/shared/ui/separator.tsx",
				"**/src/shared/ui/sheet.tsx",
				"**/src/shared/ui/skeleton.tsx",
				"**/src/shared/ui/sonner.tsx",
				"**/src/shared/ui/spinner.tsx",
				"**/src/shared/ui/textarea.tsx",
				"**/src/shared/ui/tooltip.tsx"
			],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off",
						"useKeyWithClickEvents": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off"
					}
				}
			}
		},
		{
			"includes": ["**/src/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@convex/**",
											"!@convex/_generated/**",
											"!@convex/shared/**",
											"!@convex/billing/rules",
											"!@convex/rating/rules",
											"../**/convex/**",
											"!../**/convex/_generated/**",
											"!../**/convex/shared/**",
											"!../**/convex/billing/rules",
											"!../**/convex/rating/rules"
										],
										"message": "src/ may import only @convex/_generated/* and @convex/shared/* from the backend."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/convex/shared/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"convex/server",
											"../**",
											"!../_generated/api",
											"!../_generated/dataModel"
										],
										"message": "convex/shared/ is browser-safe: from the rest of convex/ it may import only _generated/api and _generated/dataModel."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
