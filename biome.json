{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**/src/**/*",
			"**/convex/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"**/vitest.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/convex/_generated/**/*"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/src/components/ui/**/*"],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off",
						"useKeyWithClickEvents": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off"
					}
				}
			}
		},
		{
			"includes": ["**/src/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@convex/**",
											"!@convex/_generated/**",
											"!@convex/shared/**",
											"../**/convex/**",
											"!../**/convex/_generated/**",
											"!../**/convex/shared/**"
										],
										"message": "src/ may import only @convex/_generated/* and @convex/shared/* from the backend."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/features/billing/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@convex/**",
											"!@convex/_generated/**",
											"!@convex/shared/**",
											"../**/convex/**",
											"!../**/convex/_generated/**",
											"!../**/convex/shared/**"
										],
										"message": "src/ may import only @convex/_generated/* and @convex/shared/* from the backend."
									},
									{
										"group": [
											"~/features/*/**",
											"!~/features/billing/**",
											"~/features/billing",
											"../**/chat",
											"../**/chat/**",
											"../**/explore",
											"../**/explore/**",
											"../**/hiring",
											"../**/hiring/**",
											"../**/marketing",
											"../**/marketing/**",
											"../**/people",
											"../**/people/**",
											"../**/startups",
											"../**/startups/**",
											"../**/work",
											"../**/work/**"
										],
										"message": "From another area, import its front door (~/features/<area>). Inside billing/, import files directly, not ~/features/billing."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/features/chat/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@convex/**",
											"!@convex/_generated/**",
											"!@convex/shared/**",
											"../**/convex/**",
											"!../**/convex/_generated/**",
											"!../**/convex/shared/**"
										],
										"message": "src/ may import only @convex/_generated/* and @convex/shared/* from the backend."
									},
									{
										"group": [
											"~/features/*/**",
											"!~/features/chat/**",
											"~/features/chat",
											"../**/billing",
											"../**/billing/**",
											"../**/explore",
											"../**/explore/**",
											"../**/hiring",
											"../**/hiring/**",
											"../**/marketing",
											"../**/marketing/**",
											"../**/people",
											"../**/people/**",
											"../**/startups",
											"../**/startups/**",
											"../**/work",
											"../**/work/**"
										],
										"message": "From another area, import its front door (~/features/<area>). Inside chat/, import files directly, not ~/features/chat."
									}
								]
							}
