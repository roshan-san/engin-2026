									},
									{
										"group": [
											"~/features",
											"~/features/**",
											"../**/features",
											"../**/features/**",
											"./features/**"
										],
										"message": "components/ and lib/ are below every area: they may not import features/. Move the piece down, or move this file up into an area or shell/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/convex/shared/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"convex/server",
											"../**",
											"!../_generated/api",
											"!../_generated/dataModel"
										],
										"message": "convex/shared/ is browser-safe: from the rest of convex/ it may import only _generated/api and _generated/dataModel."
									}
								]
							}
						}
					}
				}
			}
		}
