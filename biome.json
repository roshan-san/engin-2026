		},
		{
			"includes": ["**/src/features/marketing/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@convex/**",
											"!@convex/_generated/**",
											"!@convex/shared/**",
											"../**/convex/**",
											"!../**/convex/_generated/**",
											"!../**/convex/shared/**"
										],
										"message": "src/ may import only @convex/_generated/* and @convex/shared/* from the backend."
									},
									{
										"group": [
											"~/features/*/**",
											"!~/features/marketing/**",
											"~/features/marketing",
											"../**/billing",
											"../**/billing/**",
											"../**/chat",
											"../**/chat/**",
											"../**/explore",
											"../**/explore/**",
											"../**/hiring",
											"../**/hiring/**",
											"../**/people",
											"../**/people/**",
											"../**/startups",
											"../**/startups/**",
											"../**/work",
											"../**/work/**"
										],
										"message": "From another area, import its front door (~/features/<area>). Inside marketing/, import files directly, not ~/features/marketing."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/features/people/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@convex/**",
											"!@convex/_generated/**",
											"!@convex/shared/**",
											"../**/convex/**",
											"!../**/convex/_generated/**",
											"!../**/convex/shared/**"
										],
										"message": "src/ may import only @convex/_generated/* and @convex/shared/* from the backend."
									},
									{
										"group": [
											"~/features/*/**",
											"!~/features/people/**",
											"~/features/people",
											"../**/billing",
											"../**/billing/**",
											"../**/chat",
											"../**/chat/**",
											"../**/explore",
											"../**/explore/**",
											"../**/hiring",
											"../**/hiring/**",
											"../**/marketing",
											"../**/marketing/**",
											"../**/startups",
											"../**/startups/**",
											"../**/work",
											"../**/work/**"
										],
										"message": "From another area, import its front door (~/features/<area>). Inside people/, import files directly, not ~/features/people."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/features/startups/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@convex/**",
											"!@convex/_generated/**",
											"!@convex/shared/**",
											"../**/convex/**",
											"!../**/convex/_generated/**",
											"!../**/convex/shared/**"
										],
										"message": "src/ may import only @convex/_generated/* and @convex/shared/* from the backend."
									},
									{
										"group": [
											"~/features/*/**",
											"!~/features/startups/**",
											"~/features/startups",
											"../**/billing",
											"../**/billing/**",
											"../**/chat",
											"../**/chat/**",
											"../**/explore",
											"../**/explore/**",
											"../**/hiring",
											"../**/hiring/**",
											"../**/marketing",
											"../**/marketing/**",
											"../**/people",
											"../**/people/**",
											"../**/work",
											"../**/work/**"
										],
										"message": "From another area, import its front door (~/features/<area>). Inside startups/, import files directly, not ~/features/startups."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/features/work/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@convex/**",
											"!@convex/_generated/**",
											"!@convex/shared/**",
											"../**/convex/**",
											"!../**/convex/_generated/**",
											"!../**/convex/shared/**"
										],
										"message": "src/ may import only @convex/_generated/* and @convex/shared/* from the backend."
