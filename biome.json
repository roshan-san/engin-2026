											"!@convex/_generated/**",
											"!@convex/shared/**",
											"../**/convex/**",
											"!../**/convex/_generated/**",
											"!../**/convex/shared/**"
										],
										"message": "src/ may import only @convex/_generated/* and @convex/shared/* from the backend."
									},
									{
										"group": [
											"~/features/*/**",
											"../**/features",
											"../**/features/**",
											"./features/**"
										],
										"message": "Import an area through its front door: ~/features/<area>."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/components/**/*", "**/src/lib/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@convex/**",
											"!@convex/_generated/**",
											"!@convex/shared/**",
											"../**/convex/**",
