{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "vite",
	"buildCommand": "pnpm exec convex deploy --cmd \"pnpm build\" --cmd-url-env-var-name VITE_CONVEX_URL",
	"outputDirectory": "dist",
	"git": {
		"deploymentEnabled": {
			"**": false,
			"main": true
		}
	},
	"rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
